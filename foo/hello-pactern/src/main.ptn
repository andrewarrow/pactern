module main;
import host::terminal;
pub fn menu() -> String {
    return "Hello Pactern\n\n  1  Show the answer\n  2  Help\n  0  Exit\n";
}
pub fn help_text() -> String {
    return "Hello Pactern\n\nUsage: pactern run --terminal -- [COMMAND]\n\nRun without a command for the interactive menu.\n\nCommands:\n  answer      Show the answer\n  help        Show this help\n\nOptions:\n  -h, --help  Show this help\n";
}
pub fn selection(choice: String) -> I64 {
    if (choice == "1" || choice == "answer") {
        return 1;
    }
    if (choice == "2" || choice == "help" || choice == "--help" || choice == "-h") {
        return 2;
    }
    if (choice == "0" || choice == "q" || choice == "quit" || choice == "exit") {
        return 0;
    }
    return -1;
}
pub fn answer() -> String {
    return "The answer is 42.\n";
}
pub fn main(term: host::terminal::Terminal) -> I64 effects { env.read, terminal.read, terminal.write } {
    let count = host::terminal::arg_count(borrow term);
    let args = host::terminal::args(borrow term);
    if (count == 1) {
        let command = selection(args[0]);
        if (command == 1) {
            host::terminal::write(borrow term, answer());
            return 0;
        }
        if (command == 2) {
            host::terminal::write(borrow term, help_text());
            return 0;
        }
        if (command == 0) {
            return 0;
        }
    }
    if (count > 0) {
        host::terminal::write_error(borrow term, "Unknown command or extra arguments. Use --help for usage.\n");
        return 2;
    }
    host::terminal::write(borrow term, menu());
    while (true) {
        host::terminal::write(borrow term, "\nChoose an option: ");
        let line = host::terminal::read_line(borrow term);
        let command = match (line) {
            Option::Some(choice) => selection(choice),
            Option::None => 0,
        };
        if (command == 0) {
            host::terminal::write(borrow term, "Goodbye!\n");
            return 0;
        }
        if (command == 1) {
            host::terminal::write(borrow term, answer());
        } else if (command == 2) {
            host::terminal::write(borrow term, help_text());
        } else {
            host::terminal::write_error(borrow term, "Choose 1, 2, or 0.\n");
        }
    }
    return 0;
}
