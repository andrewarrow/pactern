        4 => recipe_4(),
        5 => recipe_5(),
        6 => recipe_6(),
        7 => recipe_7(),
        8 => recipe_8(),
        9 => recipe_9(),
        10 => recipe_10(),
        11 => recipe_11(),
        _ => recipe_1(),
    };
}
