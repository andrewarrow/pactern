        2 => "Security review",
        3 => "Team onboarding",
        4 => "Release train",
        5 => "Database migration",
        6 => "Documentation overhaul",
        7 => "Hiring loop",
        8 => "Conference workshop",
        9 => "Learning plan",
        10 => "Community event",
        11 => "Quarterly planning",
