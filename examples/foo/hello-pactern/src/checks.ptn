pub fn view(failures: I64) -> render::View {
    return render::View {
        lines: [render::value("Regression scenarios: ", 82, "\n"), render::value("Failures: ", failures, "\n"), render::line("Checks cover task edits, date boundaries, metrics, parsing, and planning arithmetic.\n")],
        count: 3,
        prompt: "\nPress Enter for the menu (q exits): ",
    };
}
pub fn fractional_day_forecast() -> Bool {
    return planning::days_with_overhead(20, 1, 1, 20) == 25 && planning::days_with_overhead(23, 1, 6, 20) == 5;
}
pub fn zero_capacity_forecast() -> Bool {
    return planning::days_with_overhead(20, 1, 6, 100) == 0;
}
pub fn invalid_import_is_atomic() -> Bool {
    let blueprint = model::Blueprint {
        name: "Invalid sample",
        description: "Atomicity check",
        category: 0,
        count: 2,
        tasks: [model::task("Valid", 4, 1, 1), model::task("Invalid", 0, 1, 1)],
    };
    let data = board::apply(board::empty(), blueprint);
    return data.count == 0 && data.next_id == 1;
}
pub fn full_board_rejects_addition() -> Bool {
    let mut data = board::empty();
    let mut index = 0;
    while (index < 24) {
        data = board::add(data, model::task("Capacity sample", 1, 1, 1));
        index = index + 1;
    }
    let rejected = board::add(data, model::task("Overflow", 1, 1, 1));
    return data.count == 24 && rejected.count == 24 && rejected.next_id == 25;
}
pub fn final_session_id() -> Bool {
    let empty = board::empty();
    let last = model::Board {
        tasks: empty.tasks,
        count: 0,
        next_id: 365,
        day: 0,
        people: 1,
        daily_hours: 6
    };
    let accepted = board::add(last, model::task("Last ID", 1, 1, 1));
    let rejected = board::add(accepted, model::task("Too many IDs", 1, 1, 1));
    return accepted.tasks[0].id == 365 && rejected.count == 1 && rejected.next_id == 366;
}
pub fn clamped_shortfall() -> Bool {
    return planning::shortfall(100000, 100001) == 12400;
}
pub fn clamped_overrun() -> Bool {
    return planning::overrun(1000, 400) == 285;
}
