module checks;
import model;
import board;
import planning;
import metrics;
import numbers;
import render;
pub fn empty_board() -> Bool {
    let data = board::empty();
    return data.count == 0 && data.next_id == 1 && data.day == 0 && data.people == 1 && data.daily_hours == 6;
}
pub fn add_assigns_id() -> Bool {
    let data = board::add(board::empty(), model::task("First", 8, 2, 4));
    return data.count == 1 && data.next_id == 2 && data.tasks[0].id == 1 && data.tasks[0].title == "First";
}
pub fn add_rejects_bad_estimate() -> Bool {
    let data = board::add(board::empty(), model::task("Bad", 0, 2, 4));
    return data.count == 0 && data.next_id == 1;
}
pub fn add_rejects_empty_title() -> Bool {
    let data = board::add(board::empty(), model::task("", 4, 2, 4));
    return data.count == 0;
}
pub fn log_preserves_status() -> Bool {
    let initial = board::add(board::empty(), model::task("Work", 8, 2, 4));
    let data = board::log(initial, 1, 3);
    return data.tasks[0].spent == 3 && data.tasks[0].status == 0 && model::remaining(data.tasks[0]) == 5;
}
pub fn completion_clears_remaining() -> Bool {
    let initial = board::add(board::empty(), model::task("Work", 8, 2, 4));
    let data = board::status(initial, 1, 3);
    return data.tasks[0].spent == 0 && model::remaining(data.tasks[0]) == 0;
}
pub fn completed_rejects_logging() -> Bool {
    let initial = board::add(board::empty(), model::task("Work", 8, 2, 4));
    let data = board::log(board::status(initial, 1, 3), 1, 2);
    return data.tasks[0].spent == 0;
}
pub fn overrun_never_negative_remaining() -> Bool {
    let initial = board::add(board::empty(), model::task("Work", 4, 2, 4));
    let data = board::log(initial, 1, 8);
    return data.tasks[0].spent == 8 && model::remaining(data.tasks[0]) == 0 && data.tasks[0].status == 0;
}
pub fn delete_preserves_survivor_ids() -> Bool {
    let first = board::add(board::empty(), model::task("First", 4, 2, 4));
    let both = board::add(first, model::task("Second", 6, 1, 3));
    let data = board::delete(both, 1);
    return data.count == 1 && data.tasks[0].id == 2 && data.tasks[0].title == "Second" && data.next_id == 3;
}
pub fn delete_unknown_is_noop() -> Bool {
    let data = board::delete(board::empty(), 99);
    return data.count == 0 && data.next_id == 1;
}
pub fn unknown_status_is_noop() -> Bool {
    let initial = board::add(board::empty(), model::task("Work", 4, 2, 4));
    let data = board::status(initial, 1, 9);
    return data.tasks[0].status == 0;
}
pub fn priority_preserves_effort() -> Bool {
    let initial = board::add(board::empty(), model::task("Work", 4, 2, 4));
    let data = board::priority(initial, 1, 1);
    return data.tasks[0].priority == 1 && data.tasks[0].estimate == 4 && data.tasks[0].due == 4;
}
pub fn due_preserves_priority() -> Bool {
    let initial = board::add(board::empty(), model::task("Work", 4, 2, 4));
    let data = board::due(initial, 1, 0);
    return data.tasks[0].due == 0 && data.tasks[0].priority == 2;
}
pub fn settings_apply() -> Bool {
    let data = board::settings(board::empty(), 3, 7);
    return data.people == 3 && data.daily_hours == 7 && data.day == 0;
}
pub fn settings_reject_zero() -> Bool {
    let data = board::settings(board::empty(), 0, 7);
    return data.people == 1 && data.daily_hours == 6;
}
pub fn day_boundary() -> Bool {
    let final = board::advance(board::empty(), 365);
    let rejected = board::advance(final, 1);
    return final.day == 365 && rejected.day == 365;
}
pub fn overdue_excludes_today() -> Bool {
    let task = model::task("Work", 4, 2, 4);
    return !model::overdue(task, 4) && model::overdue(task, 5);
}
pub fn overdue_excludes_done() -> Bool {
    let task = model::with_status(model::task("Work", 4, 2, 4), 3);
    return !model::overdue(task, 5);
}
pub fn summary_totals() -> Bool {
    let first = board::add(board::empty(), model::task("First", 4, 2, 4));
    let both = board::add(first, model::task("Second", 6, 1, 3));
    let data = metrics::summarize(board::log(both, 1, 2));
    return data.total == 2 && data.backlog == 2 && data.estimated == 10 && data.spent == 2 && data.remaining == 8;
}
pub fn blocked_is_not_actionable() -> Bool {
    let first = board::add(board::empty(), model::task("First", 4, 1, 0));
    let blocked = board::status(first, 1, 2);
    return metrics::next(blocked) == -1 && metrics::summarize(blocked).blocked_hours == 4;
}
pub fn priority_wins_when_due_equal() -> Bool {
    let first = board::add(board::empty(), model::task("Low", 4, 5, 4));
    let both = board::add(first, model::task("High", 6, 1, 4));
    return metrics::next(both) == 1;
}
pub fn filter_completed() -> Bool {
    let task = model::with_status(model::task("Work", 4, 1, 0), 3);
    return metrics::matches(task, 3, 5) && !metrics::matches(task, 1, 5) && !metrics::matches(task, 4, 5);
}
pub fn filter_due_week() -> Bool {
    let task = model::task("Work", 4, 1, 8);
    return metrics::matches(task, 6, 1) && !metrics::matches(task, 6, 0);
}
pub fn empty_summary() -> Bool {
    let data = metrics::summarize(board::empty());
    return data.total == 0 && data.remaining == 0 && data.spent == 0 && data.overdue == 0;
}
pub fn decimal_parser() -> Bool {
    let valid = match (numbers::parse("365")) {
        Option::Some(value) => value == 365,
        Option::None => false
    };
    let invalid = match (numbers::parse("01")) {
        Option::Some(_) => false,
        Option::None => true
    };
    return valid && invalid;
}
