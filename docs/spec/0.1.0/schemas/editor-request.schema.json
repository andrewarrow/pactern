{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pactern:protocol:0.1.0:editor-request",
  "title": "Pactern 0.1.0 editor adapter request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "kind",
    "source_revision",
    "query"
  ],
  "properties": {
    "protocol_version": {
      "const": "0.1.0"
    },
    "kind": {
      "const": "editor_request"
    },
    "source_revision": {
      "$ref": "#/$defs/digest"
    },
    "query": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation"
          ],
          "properties": {
            "operation": {
              "const": "diagnostics"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "path",
            "byte"
          ],
          "properties": {
            "operation": {
              "const": "definition"
            },
            "path": {
              "$ref": "#/$defs/path"
            },
            "byte": {
              "$ref": "#/$defs/byte_offset"
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "(^/)|(/$)|(//)|(\\\\)|:|(^|/)\\.{1,2}(/|$)|[\\u0000-\\u001f\\u007f]"
      }
    },
    "byte_offset": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "minLength": 71,
      "maxLength": 71
    }
  }
}
