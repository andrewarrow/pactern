{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pactern:protocol:0.1.0:editor-response",
  "title": "Pactern 0.1.0 editor adapter result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "kind",
    "source_revision",
    "completeness",
    "reasons",
    "result"
  ],
  "properties": {
    "protocol_version": {
      "const": "0.1.0"
    },
    "kind": {
      "const": "query_result"
    },
    "source_revision": {
      "$ref": "#/$defs/digest"
    },
    "completeness": {
      "enum": [
        "complete",
        "partial"
      ]
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/span"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/editor_diagnostic"
          }
        }
      ]
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "(^/)|(/$)|(//)|(\\\\)|:|(^|/)\\.{1,2}(/|$)|[\\u0000-\\u001f\\u007f]"
      }
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "start_byte",
        "end_byte"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "start_byte": {
          "$ref": "#/$defs/byte_offset"
        },
        "end_byte": {
          "$ref": "#/$defs/byte_offset"
        }
      }
    },
    "byte_offset": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "minLength": 71,
      "maxLength": 71
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "line",
        "character"
      ],
      "properties": {
        "line": {
          "$ref": "#/$defs/byte_offset"
        },
        "character": {
          "$ref": "#/$defs/byte_offset"
        }
      }
    },
    "editor_range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "$ref": "#/$defs/position"
        },
        "end": {
          "$ref": "#/$defs/position"
        }
      }
    },
    "editor_diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "severity",
        "path",
        "range"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^PTN_[A-Z0-9]+_[A-Z0-9_]+$"
        },
        "message": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "error",
            "warning",
            "note"
          ]
        },
        "path": {
          "anyOf": [
            {
              "$ref": "#/$defs/path"
            },
            {
              "type": "null"
            }
          ]
        },
        "range": {
          "anyOf": [
            {
              "$ref": "#/$defs/editor_range"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
