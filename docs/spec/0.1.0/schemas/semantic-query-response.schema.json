{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pactern:protocol:0.1.0:semantic-query-response",
  "title": "Pactern 0.1.0 semantic query result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "kind",
    "source_revision",
    "completeness",
    "reasons",
    "result"
  ],
  "properties": {
    "protocol_version": {
      "const": "0.1.0"
    },
    "kind": {
      "const": "query_result"
    },
    "source_revision": {
      "$ref": "#/$defs/digest"
    },
    "completeness": {
      "enum": [
        "complete",
        "partial"
      ]
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/declaration"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/declaration"
          }
        },
        {
          "$ref": "#/$defs/impact"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "(^/)|(/$)|(//)|(\\\\)|:|(^|/)\\.{1,2}(/|$)|[\\u0000-\\u001f\\u007f]"
      }
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "start_byte",
        "end_byte"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "start_byte": {
          "$ref": "#/$defs/byte_offset"
        },
        "end_byte": {
          "$ref": "#/$defs/byte_offset"
        }
      }
    },
    "byte_offset": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "minLength": 71,
      "maxLength": 71
    },
    "id": {
      "type": "string",
      "pattern": "^(sym|pact)_[0-9a-f]{32}(?![\\s\\S])"
    },
    "ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      },
      "uniqueItems": true
    },
    "declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "module",
        "name",
        "kind",
        "public",
        "range",
        "name_range",
        "body_range",
        "declaration_hash",
        "signature",
        "source",
        "dependencies"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "module": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "function",
            "struct",
            "enum",
            "pact"
          ]
        },
        "public": {
          "type": "boolean"
        },
        "range": {
          "$ref": "#/$defs/span"
        },
        "name_range": {
          "$ref": "#/$defs/span"
        },
        "body_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/span"
            },
            {
              "type": "null"
            }
          ]
        },
        "declaration_hash": {
          "$ref": "#/$defs/digest"
        },
        "signature": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "dependencies": {
          "$ref": "#/$defs/ids"
        }
      }
    },
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declarations",
        "interfaces",
        "pacts"
      ],
      "properties": {
        "declarations": {
          "$ref": "#/$defs/ids"
        },
        "interfaces": {
          "$ref": "#/$defs/ids"
        },
        "pacts": {
          "$ref": "#/$defs/ids"
        }
      }
    }
  }
}
