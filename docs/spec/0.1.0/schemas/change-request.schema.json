{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pactern:protocol:0.1.0:change-request",
  "title": "Pactern 0.1.0 semantic change request",
  "oneOf": [
    {
      "$ref": "#/$defs/implementation_request"
    },
    {
      "$ref": "#/$defs/specification_request"
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])",
      "minLength": 71,
      "maxLength": 71
    },
    "symbol_id": {
      "type": "string",
      "pattern": "^sym_[0-9a-f]{32}(?![\\s\\S])",
      "minLength": 36,
      "maxLength": 36
    },
    "pact_id": {
      "type": "string",
      "pattern": "^pact_[0-9a-f]{32}(?![\\s\\S])",
      "minLength": 37,
      "maxLength": 37
    },
    "symbol_target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symbol_id",
        "expected_hash"
      ],
      "properties": {
        "symbol_id": {
          "$ref": "#/$defs/symbol_id"
        },
        "expected_hash": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "pact_target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pact_id",
        "expected_hash"
      ],
      "properties": {
        "pact_id": {
          "$ref": "#/$defs/pact_id"
        },
        "expected_hash": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "replace_function_body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "target",
        "body"
      ],
      "properties": {
        "op": {
          "const": "replace_function_body"
        },
        "target": {
          "$ref": "#/$defs/symbol_target"
        },
        "body": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "rename_symbol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "target",
        "new_name"
      ],
      "properties": {
        "op": {
          "const": "rename_symbol"
        },
        "target": {
          "$ref": "#/$defs/symbol_target"
        },
        "new_name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?![\\s\\S])",
          "minLength": 1
        }
      }
    },
    "replace_pact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "target",
        "declaration"
      ],
      "properties": {
        "op": {
          "const": "replace_pact"
        },
        "target": {
          "$ref": "#/$defs/pact_target"
        },
        "declaration": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "implementation_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "kind",
        "request_id",
        "transaction",
        "base_revision",
        "expected_policy_baseline",
        "operations"
      ],
      "properties": {
        "protocol_version": {
          "const": "0.1.0"
        },
        "kind": {
          "const": "change_request"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}(?![\\s\\S])",
          "minLength": 1,
          "maxLength": 128
        },
        "transaction": {
          "const": "implementation"
        },
        "base_revision": {
          "$ref": "#/$defs/digest"
        },
        "expected_policy_baseline": {
          "$ref": "#/$defs/digest"
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/replace_function_body"
              },
              {
                "$ref": "#/$defs/rename_symbol"
              }
            ]
          }
        }
      }
    },
    "specification_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "kind",
        "request_id",
        "transaction",
        "base_revision",
        "expected_policy_baseline",
        "operations"
      ],
      "properties": {
        "protocol_version": {
          "const": "0.1.0"
        },
        "kind": {
          "const": "change_request"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}(?![\\s\\S])",
          "minLength": 1,
          "maxLength": 128
        },
        "transaction": {
          "const": "specification"
        },
        "base_revision": {
          "$ref": "#/$defs/digest"
        },
        "expected_policy_baseline": {
          "$ref": "#/$defs/digest"
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/replace_function_body"
              },
              {
                "$ref": "#/$defs/rename_symbol"
              },
              {
                "$ref": "#/$defs/replace_pact"
              }
            ]
          }
        }
      }
    }
  }
}
