{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pactern:cli:0.1.0:source",
  "title": "Pactern CLI 0.1.0 source command success",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cli_version",
    "kind",
    "source_revision",
    "check_only",
    "files"
  ],
  "properties": {
    "cli_version": {
      "const": "0.1.0"
    },
    "kind": {
      "enum": [
        "check",
        "format"
      ]
    },
    "source_revision": {
      "$ref": "#/$defs/digest"
    },
    "check_only": {
      "type": "boolean"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "changed"
        ],
        "properties": {
          "path": {
            "$ref": "#/$defs/path"
          },
          "changed": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])",
      "minLength": 71,
      "maxLength": 71
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "(^/)|(/$)|(//)|(\\\\)|:|(^|/)\\.{1,2}(/|$)|[\\u0000-\\u001f\\u007f]"
      }
    }
  }
}
