{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pactern:cli:0.1.0:version",
  "title": "Pactern CLI 0.1.0 version output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "cli_version",
    "tool_version",
    "language_version",
    "protocol_version"
  ],
  "properties": {
    "kind": {
      "const": "version"
    },
    "cli_version": {
      "const": "0.1.0",
      "description": "Version of this CLI output contract; independent of the diagnostic protocol version."
    },
    "tool_version": {
      "type": "string",
      "minLength": 1
    },
    "language_version": {
      "type": "string",
      "minLength": 1,
      "description": "Version of the target language specification, not a claim of implementation conformance."
    },
    "protocol_version": {
      "type": "string",
      "minLength": 1
    }
  }
}
